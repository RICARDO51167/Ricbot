#!/bin/sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${RICBOT_JAR:-}" ] && [ -f "${RICBOT_JAR:-}" ]; then
  JAR="$RICBOT_JAR"
else
  JAR=""
  if [ -d "$BASE_DIR/target" ]; then
    JAR=$(ls -t "$BASE_DIR"/target/Ricbot-*.jar 2>/dev/null | head -n 1 || true)
  fi

  if [ -z "${JAR:-}" ]; then
    sh "$BASE_DIR/mvnw" -q package
    JAR=$(ls -t "$BASE_DIR"/target/Ricbot-*.jar 2>/dev/null | head -n 1 || true)
  fi
fi

if [ -z "${JAR:-}" ] || [ ! -f "$JAR" ]; then
  echo "ricbot: failed to locate built jar under $BASE_DIR/target" >&2
  exit 1
fi

while true; do
  java -jar "$JAR" "$@"
  EXIT_CODE=$?
  if [ $EXIT_CODE -ne 100 ]; then
    exit $EXIT_CODE
  fi
  echo "Restarting ricbot..."
done