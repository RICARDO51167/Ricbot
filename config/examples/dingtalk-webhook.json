{
  "api": {
    "host": "127.0.0.1",
    "port": 8000,
    "bearer_token": "${RICBOT_API_BEARER_TOKEN}"
  },
  "channels": {
    "dingtalk": {
      "enabled": true,
      "app_key": "${DINGTALK_APP_KEY}",
      "app_secret": "${DINGTALK_APP_SECRET}",
      "webhookSecret": "${DINGTALK_WEBHOOK_SECRET}",
      "allow_from": ["*"]
    }
  }
}
