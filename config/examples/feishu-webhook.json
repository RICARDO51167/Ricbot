{
  "api": {
    "host": "127.0.0.1",
    "port": 8000,
    "bearer_token": "${RICBOT_API_BEARER_TOKEN}"
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "app_id": "${FEISHU_APP_ID}",
      "app_secret": "${FEISHU_APP_SECRET}",
      "webhookToken": "${FEISHU_WEBHOOK_TOKEN}",
      "encryptKey": "${FEISHU_ENCRYPT_KEY}",
      "allow_from": ["*"]
    }
  }
}
